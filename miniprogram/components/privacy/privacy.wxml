<view class="privacy-mask" wx:if="{{showPrivacy}}">
  <view class="privacy-container">
    <view class="privacy-header">
      <view class="privacy-mark">P</view>
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-subtitle">压力表智能管家</text>
    </view>
    <view class="privacy-content">
      <text class="privacy-text">使用服务前，请阅读并同意</text>
      <text class="privacy-link" bindtap="openPrivacyContract">《用户隐私保护指引》</text>
      <text class="privacy-text">，了解我们如何收集、使用和保护企业及个人信息。</text>
      <text class="privacy-note">拒绝授权将无法使用登录、图片识别和企业台账等功能。</text>
    </view>
    <view class="privacy-footer">
      <button class="btn-reject" bindtap="handleDisagree">拒绝</button>
      <button class="btn-agree" id="agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgree">同意并继续</button>
    </view>
  </view>
</view>
