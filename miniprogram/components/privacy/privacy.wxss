.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.46);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-container {
  width: 620rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(17, 24, 39, 0.08);
  border-radius: 34rpx;
  overflow: hidden;
  box-shadow: 0 30rpx 90rpx rgba(15, 23, 42, 0.22);
}

.privacy-header {
  padding: 42rpx 36rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.privacy-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  background: linear-gradient(180deg, #2684ff 0%, #0868d8 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 122, 255, 0.2);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.privacy-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b8494;
}

.privacy-content {
  padding: 18rpx 40rpx 30rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.privacy-text {
  display: inline;
  font-size: 27rpx;
  color: #4b5563;
  line-height: 1.7;
}

.privacy-link {
  display: inline;
  font-size: 27rpx;
  color: #007aff;
  font-weight: 600;
}

.privacy-note {
  display: block;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f3f6fa;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.55;
}

.privacy-footer {
  display: flex;
  padding: 0 36rpx 38rpx;
  gap: 18rpx;
}

.btn-reject {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #4b5563;
  background: #eef1f5;
  border: none;
  border-radius: 44rpx;
}

.btn-reject::after {
  border: none;
}

.btn-agree {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: #007aff;
  border: none;
  border-radius: 44rpx;
}

.btn-agree::after {
  border: none;
}
