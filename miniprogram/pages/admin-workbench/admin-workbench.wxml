<view class="page-shell admin-workbench-page">
  <scroll-view scroll-y class="admin-workbench-scroll">
    <view class="content-wrapper admin-workbench-wrapper">
      <view class="panel hero-panel">
        <view class="panel-section">
          <view class="eyebrow">{{adminName}}</view>
          <view class="page-title hero-title">{{text.heroTitle}}</view>
        </view>
      </view>

      <view class="panel">
        <view class="panel-section">
          <text class="section-title">{{text.infoTitle}}</text>
          <view class="info-list">
            <view class="list-cell info-cell">
              <text class="cell-title">{{text.labels.username}}</text>
              <text class="cell-subtitle">{{adminInfo.username || '-'}}</text>
            </view>
            <view class="list-cell info-cell">
              <text class="cell-title">{{text.labels.role}}</text>
              <text class="cell-subtitle">{{displayRole}}</text>
            </view>
            <view class="list-cell info-cell" wx:if="{{!isAdmin}}">
              <text class="cell-title">{{text.labels.district}}</text>
              <text class="cell-subtitle">{{adminDistrict || '-'}}</text>
            </view>
            <view class="list-cell info-cell">
              <text class="cell-title">{{text.labels.loginTime}}</text>
              <text class="cell-subtitle">{{loginTime || '-'}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="panel">
        <view class="panel-section">
          <text class="section-title">{{text.sectionTitle}}</text>
          <view class="entry-list">
            <view
              class="list-cell entry-cell"
              wx:for="{{entries}}"
              wx:key="key"
              data-action="{{item.action}}"
              bindtap="onTapEntry"
            >
              <view>
                <text class="cell-title">{{item.title}}</text>
              </view>
              <text class="entry-arrow">></text>
            </view>
          </view>
        </view>
      </view>

      <view class="action-section">
        <button class="ghost-button logout-button" bindtap="logout">{{text.logout}}</button>
      </view>
    </view>
  </scroll-view>

  <view class="admin-bottom-switch">
    <view class="mode-switch">
      <view class="mode-pill" bindtap="goToPreviewPlatform">
        <text>{{text.switchPreview}}</text>
      </view>
      <view class="mode-pill active">
        <text>{{text.switchWorkbench}}</text>
      </view>
    </view>
  </view>
</view>
