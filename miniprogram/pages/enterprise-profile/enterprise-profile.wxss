.enterprise-profile-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(210, 225, 255, 0.72), transparent 28%),
    #f7f9fc;
}

.profile-shell {
  padding: 30rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  padding: 30rpx 10rpx 34rpx;
}

.profile-eyebrow {
  font-size: 24rpx;
  color: #6b7a90;
}

.profile-heading {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #182033;
}

.profile-summary {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #7b8799;
}

.profile-form-card {
  padding: 8rpx 30rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(214, 222, 235, 0.9);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(28, 48, 86, 0.07);
}

.form-group {
  padding: 26rpx 0 28rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.form-group-last {
  border-bottom: none;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #667085;
}

.field-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 2rpx solid #dde3ec;
  border-radius: 18rpx;
  background: #ffffff;
  color: #20283a;
  font-size: 28rpx;
}

.field-input:focus {
  border-color: #147cff;
}

.input-placeholder {
  color: #a0a9b8;
}

.readonly-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.readonly-group .field-label {
  margin-bottom: 0;
  flex: none;
}

.readonly-value {
  min-width: 0;
  color: #293348;
  font-size: 28rpx;
  font-weight: 500;
  text-align: right;
  overflow-wrap: anywhere;
}

.code-value {
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  color: #20283a;
}

.picker-arrow {
  color: #98a2b3;
  font-size: 38rpx;
}

.profile-save {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  margin: 30rpx 0 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #147cff 0%, #006be6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 14rpx 30rpx rgba(0, 112, 232, 0.22);
}

.profile-save::after {
  border: none;
}

.profile-save.is-loading {
  opacity: 0.78;
}
