.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(221, 227, 240, 0.84), transparent 34%),
    radial-gradient(circle at bottom right, rgba(236, 240, 247, 0.94), transparent 36%),
    #f7f9fc;
}

.login-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 40rpx 48rpx;
}

.login-card {
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
  padding: 52rpx 42rpx 38rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(214, 222, 235, 0.9);
  box-shadow: 0 22rpx 70rpx rgba(28, 48, 86, 0.08);
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a73e8 0%, #1358bf 100%);
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(26, 115, 232, 0.2);
}

.brand-name {
  font-size: 24rpx;
  line-height: 1;
  color: #5f6368;
}

.login-copy {
  margin-top: 34rpx;
}

.login-title {
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #202124;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #5f6368;
}

.login-form {
  margin-top: 36rpx;
}

.manual-submit {
  width: 100%;
  margin: 0;
}

.login-submit {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #147cff 0%, #006be6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 14rpx 30rpx rgba(0, 112, 232, 0.22);
}

.login-submit::after {
  border: none;
}

.login-submit.is-loading {
  opacity: 0.82;
}

.login-actions {
  width: 100%;
  min-height: 64rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  background: #f6f8fb;
}

.login-action-button {
  flex: 1;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  background: transparent;
  color: #475467;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.login-action-button::after {
  border: none;
}

.login-action-button:active {
  background: #edf2f8;
}

.login-action-divider {
  width: 1rpx;
  height: 28rpx;
  flex: none;
  background: #dfe4ec;
}
