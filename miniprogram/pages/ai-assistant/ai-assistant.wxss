.page-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.ai-wrapper {
  padding-top: var(--space-5);
  padding-bottom: 240rpx;
}

.ai-hero,
.ai-chat {
  margin-bottom: var(--space-5);
}

.ai-chat {
  min-height: calc(100vh - 500rpx);
  box-sizing: border-box;
}

.ai-chat .panel-section {
  min-height: calc(100vh - 560rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.ai-title {
  margin-top: var(--space-4);
}

.ai-actions {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.ai-action {
  flex: 1;
}

.ai-action.is-disabled {
  opacity: 0.58;
  box-shadow: none;
}

.ai-action-text {
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
}

.ai-action-text.is-primary {
  color: var(--color-text-white);
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  flex: 1;
}

.message-item {
  width: 100%;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.user-row {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
}

.assistant-avatar {
  position: relative;
  background: linear-gradient(145deg, #7c6bea, #2f8cff);
  box-shadow: 0 10rpx 22rpx rgba(47, 140, 255, 0.22);
}

.assistant-avatar::before,
.assistant-avatar::after {
  content: "";
  position: absolute;
  top: 8rpx;
  width: 6rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: #ff6b6b;
}

.assistant-avatar::before {
  left: 16rpx;
}

.assistant-avatar::after {
  right: 16rpx;
}

.bot-face {
  width: 38rpx;
  height: 30rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.96);
  position: relative;
  box-shadow: inset 0 -3rpx 0 rgba(17, 24, 39, 0.08);
}

.bot-eye {
  position: absolute;
  top: 10rpx;
  width: 6rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #0f172a;
}

.bot-eye.left {
  left: 10rpx;
}

.bot-eye.right {
  right: 10rpx;
}

.bot-mouth {
  position: absolute;
  left: 14rpx;
  bottom: 7rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: rgba(15, 23, 42, 0.55);
}

.user-avatar {
  background: rgba(17, 24, 39, 0.08);
  color: var(--color-text-main);
}

.message-content {
  max-width: 84%;
  display: flex;
  flex-direction: column;
}

.user-content {
  align-items: flex-end;
}

.message-bubble {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
}

.assistant-bubble {
  background: rgba(255, 255, 255, 0.84);
}

.user-bubble {
  background: var(--color-brand);
  border-color: transparent;
}

.message-text {
  font-size: var(--font-size-body);
  line-height: 1.7;
  word-break: break-word;
}

.assistant-bubble .message-text {
  color: var(--color-text-main);
}

.user-bubble .message-text {
  color: var(--color-text-white);
}

.message-time {
  margin-top: 8rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.image-bubble {
  padding: 12rpx;
}

.chat-image,
.result-image {
  width: 320rpx;
  height: 220rpx;
  border-radius: 18rpx;
  display: block;
}

.image-caption {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-size-caption);
  color: rgba(255, 255, 255, 0.88);
}

.image-batch-grid {
  width: 330rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.image-batch-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
}

.result-bubble {
  width: 100%;
  box-sizing: border-box;
}

.result-title {
  display: block;
  font-size: var(--font-size-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-main);
}

.result-summary {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-size-footnote);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.result-image {
  margin-top: var(--space-4);
}

.recognition-status {
  margin-top: var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.recognition-badge {
  padding: 8rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-caption);
  color: #237a49;
  background: rgba(52, 199, 89, 0.11);
}

.recognition-badge.warning {
  color: #9a6700;
  background: rgba(255, 159, 10, 0.13);
}

.recognition-badge.risk {
  color: #b42318;
  background: rgba(255, 59, 48, 0.1);
}

.recognition-review {
  font-size: var(--font-size-caption);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.result-field-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.result-field {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.03);
}

.result-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.result-field-label {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.result-field-review {
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 159, 10, 0.1);
  color: #9a6700;
  font-size: 20rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.result-field-review.risk {
  background: rgba(255, 59, 48, 0.1);
  color: #b42318;
}

.result-field-value {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-size-footnote);
  line-height: 1.55;
  color: var(--color-text-main);
}

.result-action {
  margin-top: var(--space-4);
  min-height: 78rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-action-text {
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-white);
}

.batch-list {
  margin-top: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.batch-row {
  min-height: 88rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.035);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.batch-row.error {
  background: rgba(255, 59, 48, 0.055);
}

.batch-row.duplicate {
  background: rgba(255, 159, 10, 0.07);
}

.batch-thumb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.batch-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(0, 122, 255, 0.09);
  color: var(--color-brand);
  font-size: var(--font-size-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.batch-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.batch-title {
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-subtitle {
  font-size: var(--font-size-caption);
  line-height: 1.45;
  color: var(--color-text-tertiary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.batch-status {
  padding: 7rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(52, 199, 89, 0.1);
  color: #237a49;
  font-size: var(--font-size-caption);
  flex-shrink: 0;
}

.batch-row.error .batch-status {
  color: #b42318;
  background: rgba(255, 59, 48, 0.1);
}

.batch-row.duplicate .batch-status {
  color: #9a6700;
  background: rgba(255, 159, 10, 0.12);
}

.batch-more,
.batch-complete,
.batch-cancelled {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.batch-complete {
  color: #237a49;
}

.batch-cancelled {
  color: var(--color-text-secondary);
}

.debug-card {
  margin-top: var(--space-4);
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(0, 122, 255, 0.06);
  border: 1rpx solid rgba(0, 122, 255, 0.1);
}

.debug-toggle {
  margin-top: var(--space-4);
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.03);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.debug-toggle-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.debug-toggle-arrow {
  font-size: var(--font-size-caption);
  color: var(--color-brand);
}

.debug-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
}

.debug-line {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-size-caption);
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-break: break-word;
}

.crud-item-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.crud-item,
.crud-pick {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.03);
  border: 1rpx solid rgba(17, 24, 39, 0.04);
}

.crud-item-title,
.crud-pick-title {
  display: block;
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-main);
}

.crud-item-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.crud-actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.crud-action {
  flex: 1;
  min-height: 78rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.crud-action.primary {
  background: var(--color-brand);
}

.crud-action.secondary {
  background: rgba(17, 24, 39, 0.06);
}

.crud-action-text {
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-white);
}

.crud-action-text.secondary {
  color: var(--color-text-main);
}

.crud-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.crud-pick-action {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-brand);
}

.equipment-candidate-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.equipment-candidate {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17, 24, 39, 0.03);
  border: 1rpx solid rgba(17, 24, 39, 0.04);
}

.equipment-candidate-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
  background: rgba(0, 122, 255, 0.1);
}

.equipment-candidate-main {
  min-width: 0;
  flex: 1;
}

.equipment-candidate-title,
.equipment-candidate-subtitle {
  display: block;
}

.equipment-candidate-title {
  font-size: var(--font-size-footnote);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-main);
}

.equipment-candidate-subtitle {
  margin-top: 6rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.equipment-candidate-action {
  flex: 0 0 auto;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-brand);
}

.loading-text {
  font-size: var(--font-size-footnote);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.vision-progress {
  width: 360rpx;
  margin-top: 16rpx;
}

.vision-progress-track {
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.08);
}

.vision-progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #007aff 0%, #38a3ff 100%);
  transition: width 220ms ease;
}

.vision-progress-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.vision-progress-failed {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-size-caption);
  line-height: 1.45;
  color: #b42318;
}

.empty-chat {
  flex: 1;
  min-height: 520rpx;
  padding: var(--space-4) 0 var(--space-2);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.empty-chat-title {
  display: block;
  font-size: var(--font-size-callout);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-main);
}

.empty-chat-desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-size-footnote);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.page-spacer {
  height: 80rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(248, 249, 252, 0.86);
  backdrop-filter: var(--blur-panel);
  border-top: 1rpx solid rgba(17, 24, 39, 0.06);
}

.composer-tools {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.composer-tool {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.composer-upload-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-main);
  font-weight: var(--font-weight-medium);
}

.composer-inner {
  display: flex;
  align-items: flex-end;
  gap: var(--space-3);
  padding: 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(17, 24, 39, 0.06);
}

.composer-input {
  flex: 1;
  min-height: 48rpx;
  max-height: 180rpx;
  font-size: var(--font-size-body);
  line-height: 1.55;
  color: var(--color-text-main);
}

.composer-send {
  width: 82rpx;
  height: 82rpx;
  border-radius: 41rpx;
  background: rgba(17, 24, 39, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.composer-send.active {
  background: var(--color-brand);
}

.composer-send-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-white);
}

.composer-tip {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}
