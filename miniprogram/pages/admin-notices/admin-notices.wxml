<view class="page-shell notices-page">
  <scroll-view scroll-y class="notices-scroll">
    <view class="content-wrapper notices-wrapper">
      <view class="panel hero-panel">
        <view class="panel-section">
          <view class="hero-row">
            <view>
              <view class="eyebrow">企业触达</view>
              <view class="page-title hero-title">企业提醒</view>
            </view>
            <view class="send-entry" bindtap="goSendNotice">发新提醒</view>
          </view>
        </view>
      </view>

      <view class="summary-grid">
        <view class="summary-card danger">
          <text class="summary-value">{{summary.unread}}</text>
          <text class="summary-label">未读</text>
        </view>
        <view class="summary-card warning">
          <text class="summary-value">{{summary.deferred}}</text>
          <text class="summary-label">稍后处理</text>
        </view>
        <view class="summary-card success">
          <text class="summary-value">{{summary.read}}</text>
          <text class="summary-label">已读</text>
        </view>
      </view>

      <view class="panel">
        <view class="panel-section">
          <view class="notice-filter">
            <view
              class="notice-filter-item {{statusFilter === item.key ? 'active' : ''}}"
              wx:for="{{filters}}"
              wx:key="key"
              data-status="{{item.key}}"
              bindtap="changeFilter"
            >{{item.label}}</view>
          </view>

          <view class="notice-list" wx:if="{{notices.length}}">
            <view
              class="notice-cell"
              wx:for="{{notices}}"
              wx:key="_id"
              data-enterprise="{{item.enterpriseName}}"
              bindtap="openEnterprise"
            >
              <view class="notice-cell-head">
                <view>
                  <text class="notice-enterprise">{{item.enterpriseName}}</text>
                  <text class="notice-district">{{item.district || '未设置辖区'}}</text>
                </view>
                <view class="notice-status {{item.statusClass}}">{{item.statusText}}</view>
              </view>
              <text class="notice-title">{{item.title}}</text>
              <text class="notice-content">{{item.content}}</text>
              <view class="notice-meta">
                <text>{{item.priorityText}}</text>
                <text>{{item.createdBy || '管理员'}}</text>
                <text>{{item.createdAtText}}</text>
              </view>
              <text class="notice-read-time" wx:if="{{item.readAtText}}">企业确认：{{item.readAtText}}</text>
            </view>
          </view>

          <view class="empty-state" wx:if="{{!notices.length && !loading}}">
            <text>暂无提醒记录</text>
          </view>
          <view class="empty-state" wx:if="{{loading}}">
            <text>加载中...</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
