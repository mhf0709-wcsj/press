.notices-scroll {
  height: 100vh;
}

.notices-wrapper {
  padding-top: var(--space-5);
  padding-bottom: var(--space-8);
}

.hero-panel {
  margin-bottom: var(--space-4);
}

.hero-title {
  margin-top: var(--space-3);
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.send-entry {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  color: #ffffff;
  background: var(--color-brand);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-semibold);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: var(--space-4);
}

.summary-card {
  min-height: 138rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.summary-card.danger {
  background: #fff0f0;
}

.summary-card.warning {
  background: #fff7e8;
}

.summary-card.success {
  background: #ecf9f1;
}

.summary-value {
  color: var(--color-text-primary);
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
}

.summary-label {
  color: var(--color-text-secondary);
  font-size: var(--font-size-caption);
}

.notice-filter {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: var(--space-5);
  border-radius: var(--radius-pill);
  background: rgba(17, 24, 39, 0.05);
}

.notice-filter-item {
  min-height: 62rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.notice-filter-item.active {
  color: var(--color-brand);
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.08);
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.notice-cell {
  padding: 28rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.07);
  border-radius: var(--radius-lg);
  background: #ffffff;
}

.notice-cell-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.notice-enterprise,
.notice-district,
.notice-title,
.notice-content,
.notice-read-time {
  display: block;
}

.notice-enterprise {
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
}

.notice-district {
  margin-top: 6rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-caption);
}

.notice-status {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  font-size: var(--font-size-caption);
}

.notice-status.unread {
  color: #b42318;
  background: rgba(239, 68, 68, 0.12);
}

.notice-status.deferred {
  color: #9a5b00;
  background: rgba(245, 158, 11, 0.14);
}

.notice-status.read {
  color: #16794a;
  background: rgba(34, 197, 94, 0.12);
}

.notice-title {
  margin-top: 22rpx;
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: var(--font-weight-semibold);
}

.notice-content {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-caption);
  line-height: 1.65;
}

.notice-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.notice-read-time {
  margin-top: 12rpx;
  color: #16794a;
  font-size: 22rpx;
}

.empty-state {
  padding: 60rpx 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: var(--font-size-caption);
}
